{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/jobs.js": { "maxDuration": 60 },
    "api/trends.js": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/guide", "dest": "/public/guide.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
